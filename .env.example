# 必填
# JWT_SECRET: HMAC 签名密钥，最少 32 字符。生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# CRYPTO_KEY_V1: Fernet 密钥（44 字符 url-safe base64）。生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 启动时会校验可否构造 Fernet 实例，无效即拒绝启动（spec §124）。
CRYPTO_KEY_V1=
# 数据源（主源 MXNZP 鉴权需 app_id + app_secret 双参数，见 .env.example 顶部说明）
MXNZP_API_KEY=
MXNZP_APP_SECRET=
JUHE_API_KEY=
# 高德地图 Web 服务 API Key（用于仪表盘「附近代销点」POI 搜索；不配则回退示例数据）
# 申请：https://lbs.amap.com/dev/key/app
AMAP_API_KEY=
# SMTP（启用 email 渠道时必填）
SMTP_HOST=
SMTP_PORT=465
SMTP_ENCRYPTION=SSL/TLS
SMTP_USER=
SMTP_PASS=
SMTP_FROM=lottery@example.com
# 管理员 Bark 兜底告警（启用 email 时必填）
ADMIN_BARK_KEY=
# 运行环境
DATABASE_URL=sqlite:///./data/lottery.db
TZ=Asia/Shanghai
# Cookie secure 标志：生产（HTTPS）保持默认 true；本地 http 开发设 false。
# 不设则默认 true——本地开发登录会因 http 不回传 cookie 而失败，需显式设 false。
COOKIE_SECURE=true
# CORS 允许的 origin（JSON 列表）。生产填实际域名，如 ["https://lottery.example.com"]
CORS_ORIGINS=["http://localhost:5173"]
# HTTPS 部署（局域网自签证书）：geolocation API 要求安全上下文，HTTP 下浏览器禁用定位。
# 1. 生成自签证书（NAS_IP 替换为实际 IP，如 <NAS_IP>）：
#    mkdir -p certs && openssl req -x509 -newkey rsa:2048 -nodes \
#      -keyout certs/key.pem -out certs/cert.pem -days 3650 \
#      -subj "/CN=<NAS_IP>" -addext "subjectAltName=IP:<NAS_IP>"
# 2. 配置以下两个变量 → uvicorn 启动时自动启用 SSL（不配则走 HTTP）
# 3. COOKIE_SECURE 改 true，CORS_ORIGINS 加 "https://<NAS_IP>:8280"
SSL_CERT_FILE=/app/certs/cert.pem
SSL_KEY_FILE=/app/certs/key.pem
